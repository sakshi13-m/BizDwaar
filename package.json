{
  "name": "bizdwaar",
  "version": "1.0.0",
  "description": "AI-powered digital launch companion for micro-businesses | GoDaddy Inclusive Innovation Hackathon 2026",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.9.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.3.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}

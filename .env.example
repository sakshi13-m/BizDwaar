# -------------------------------------------------------
# Bizdwaar — environment variable reference
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
# -------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Proxy (0 locally; set verified hop count in GoDaddy production)
TRUST_PROXY_HOPS=0

# MySQL database
# On GoDaddy Platform these are injected automatically — do not set them in secrets manually.
# For local development, run a local MySQL instance and fill these in.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bizdwaar
DB_USER=
DB_PASSWORD=

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5
# Max Claude calls per UTC day across all users (spend guard; 0 = AI off). Default 150.
AI_DAILY_LIMIT=150

# Optional admin fallback (/owner/admin) — can manage ANY business page.
# Must be at least 32 random characters, otherwise the fallback stays disabled.
# Owners never need this: they get an automatic per-browser session.
OWNER_ADMIN_TOKEN=

# Email (owner login codes + enquiry notifications).
# GoDaddy hosting blocks outbound SMTP, so production uses Resend's HTTPS API.
# EMAIL_FROM must use a domain verified in Resend, e.g. Bizdwaar <login@bizdwaar.in>
RESEND_API_KEY=
EMAIL_FROM=

# Optional SMTP fallback for local development only (587 = STARTTLS, 465 = TLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Fallback enquiry recipient for pages not linked to an owner email — never accept from browser
ENQUIRY_TO=

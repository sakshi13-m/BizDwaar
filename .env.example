# -------------------------------------------------------
# Bizdwaar — environment variable reference
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
# -------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Proxy (0 locally; set verified hop count in GoDaddy production)
TRUST_PROXY_HOPS=0

# MongoDB Atlas
MONGODB_URI=

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5

# Owner access gate (hackathon demo gate — not production auth)
OWNER_ADMIN_TOKEN=
COOKIE_SECRET=

# SMTP — confirm values from your actual purchased mailbox provider
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Fixed enquiry recipient — set server-side; never accept from browser
ENQUIRY_TO=
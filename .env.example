# -------------------------------------------------------
# Bizdwaar — environment variable reference
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
# -------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# Proxy (0 locally; set verified hop count in GoDaddy production)
TRUST_PROXY_HOPS=0

# MySQL database
# On GoDaddy Platform these are injected automatically — do not set them in secrets manually.
# For local development, run a local MySQL instance and fill these in.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bizdwaar
DB_USER=
DB_PASSWORD=

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5

# Owner access gate (hackathon demo gate — not production auth)
OWNER_ADMIN_TOKEN=
COOKIE_SECRET=

# SMTP — confirm values from your mailbox provider
# Note: GoDaddy Platform blocks outbound SMTP ports 465 and 587.
# Enquiries are saved to the database regardless; use the owner inbox to view them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Fixed enquiry recipient — set server-side; never accept from browser
ENQUIRY_TO=
